{
  "name": "@haloai/collab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx --env-file-if-exists=../../.env.local watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsup src/index.ts src/main.ts --format esm --platform node --target node22 --out-dir dist --clean --sourcemap",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@haloai/contracts": "workspace:*",
    "@haloai/logger": "workspace:*",
    "@hocuspocus/server": "^4.5.0",
    "pino": "^10.3.1",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.27",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
