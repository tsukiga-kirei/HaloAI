# 复制为 .env.production，只保存在部署主机。所有 change_me 值都必须替换。
HALOAI_DOMAIN=halo.example.com
ACME_EMAIL=ops@example.com
HALOAI_IMAGE_PREFIX=haloai
HALOAI_IMAGE_TAG=latest
GATEWAY_HTTP_PORT=80
GATEWAY_HTTPS_PORT=443

POSTGRES_DB=haloai
POSTGRES_USER=haloai_admin
POSTGRES_PASSWORD=change_me_admin_password
HALOAI_APP_USER=haloai_app
HALOAI_APP_PASSWORD=change_me_app_password
HALOAI_AUTH_USER=haloai_auth
HALOAI_AUTH_PASSWORD=change_me_auth_password

# URL 中的用户名和密码必须进行 percent-encoding，并与上面的角色口令一致。
DATABASE_ADMIN_URL=postgresql://haloai_admin:change_me_admin_password@postgres:5432/haloai
DATABASE_URL=postgresql://haloai_app:change_me_app_password@postgres:5432/haloai
AUTH_DATABASE_URL=postgresql://haloai_auth:change_me_auth_password@postgres:5432/haloai

BETTER_AUTH_SECRET=change_me_at_least_32_random_characters
LOG_LEVEL=info
WORKER_CONCURRENCY=4
DOCKER_LOG_MAX_SIZE=20m
DOCKER_LOG_MAX_FILE=10
