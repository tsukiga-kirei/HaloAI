
# 至少 32 个字符；生产环境必须由密钥管理系统生成并注入，禁止提交真实值。
BETTER_AUTH_SECRET=haloai-local-auth-secret-change-before-production
# 数据库不透明会话 Cookie 默认 7 天到期、每天滑动续期；系统设置页展示这里的真实生效值。
AUTH_SESSION_EXPIRES_IN_SECONDS=604800
AUTH_SESSION_UPDATE_AGE_SECONDS=86400
# 32 字节 Base64 主密钥；只加密模型凭据，生产不得使用本地示例或复用 BETTER_AUTH_SECRET。
MODEL_SECRET_ENCRYPTION_KEY=aGFsb2FpLWRldi1tb2RlbC1zZWNyZXQta2V5LTMyISE=
MODEL_SECRET_KEY_VERSION=v1
LOG_LEVEL=info
# 相对路径按仓库根解析；API、Collab、Worker 会同时写终端与各自 JSONL 文件。
LOG_DIR=./logs
WORKER_CONCURRENCY=4

# DEMO_MODE=true 只决定 pnpm db:seed 是否写入 packages/db/devdata。
# 它不能跳过登录、Cookie 会话或服务端授权，也不再打开协作服务的固定 ticket。
# 生产环境必须保持关闭。
DEMO_MODE=true

# PostgreSQL 同时承载业务数据、耐久任务和事务 Outbox。
# 应用连接不拥有表，也没有 BYPASSRLS；迁移连接只用于受控迁移，禁止进入 Web 或 Worker 请求路径。
# 下面这组账号密码给本地 compose 初始化登录角色用，必须与三串 DATABASE_*_URL 一致。
# 生产把同一组变量注入密钥环境；不要提交真实口令。已有数据卷不会重跑 init，改密需重建卷或手动 ALTER ROLE。
POSTGRES_DB=haloai
POSTGRES_USER=haloai_admin
POSTGRES_PASSWORD=haloai_admin_local
POSTGRES_PORT=5432
HALOAI_APP_USER=haloai_app
HALOAI_APP_PASSWORD=haloai_app_local
HALOAI_AUTH_USER=haloai_auth
HALOAI_AUTH_PASSWORD=haloai_auth_local
DATABASE_URL=postgresql://haloai_app:haloai_app_local@localhost:5432/haloai
AUTH_DATABASE_URL=postgresql://haloai_auth:haloai_auth_local@localhost:5432/haloai
DATABASE_ADMIN_URL=postgresql://haloai_admin:haloai_admin_local@localhost:5432/haloai
DATABASE_TEST_URL=postgresql://haloai_app:haloai_app_local@localhost:5432/haloai
DATABASE_TEST_ADMIN_URL=postgresql://haloai_admin:haloai_admin_local@localhost:5432/haloai

# 仅便于本地尚未接入邮件服务时复制邀请链接；生产环境必须保持 false。
EXPOSE_DEVELOPMENT_INVITE_TOKENS=true

# 生产环境的模型凭据按工作空间保存在服务端密钥代理中。
# 这些值绝不能使用 NEXT_PUBLIC_ 前缀，也不能发给浏览器。
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
