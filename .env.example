# API 与协作服务使用独立前缀，避免同时运行时争用端口。
API_HOST=127.0.0.1
API_PORT=3100
API_WEB_ORIGIN=http://localhost:3000
AUTH_BASE_URL=http://localhost:3100
# 至少 32 个字符；生产环境必须由密钥管理系统生成并注入，禁止提交真实值。
BETTER_AUTH_SECRET=haloai-local-auth-secret-change-before-production
COLLAB_HOST=127.0.0.1
COLLAB_PORT=3200
COLLAB_WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info
WORKER_CONCURRENCY=4

# Foundation 协作演示只接受这张固定、文档级 ticket；生产环境禁止 Demo 模式。
DEMO_MODE=true
DEMO_TOKEN=haloai-local-collaboration-ticket-000001
DEMO_ACTOR_ID=actor_human_001
DEMO_WORKSPACE_ID=workspace_00001
DEMO_DOCUMENT_ID=document_000001
DEMO_ACCESS=write

# 仅用于本地查看工作空间后台的服务端预览角色；生产环境无论此值为何都默认拒绝后台访问。
HALOAI_ADMIN_PREVIEW_ROLE=owner

# PostgreSQL 同时承载业务数据、耐久任务和事务 Outbox。
# 应用连接不拥有表，也没有 BYPASSRLS；迁移连接只用于受控迁移，禁止进入 Web 或 Worker 请求路径。
DATABASE_URL=postgresql://haloai_app:haloai_app_local@localhost:5432/haloai
AUTH_DATABASE_URL=postgresql://haloai_auth:haloai_auth_local@localhost:5432/haloai
DATABASE_ADMIN_URL=postgresql://haloai_admin:haloai_admin_local@localhost:5432/haloai
DATABASE_TEST_URL=postgresql://haloai_app:haloai_app_local@localhost:5432/haloai
DATABASE_TEST_ADMIN_URL=postgresql://haloai_admin:haloai_admin_local@localhost:5432/haloai

# 仅便于本地尚未接入邮件服务时复制邀请链接；生产环境必须保持 false。
EXPOSE_DEVELOPMENT_INVITE_TOKENS=true

# 浏览器端只读取公开 API 地址，不得使用此前缀暴露数据库、模型或认证密钥。
NEXT_PUBLIC_API_BASE_URL=http://localhost:3100
NEXT_PUBLIC_AUTH_MODE=real

# 生产环境的模型凭据按工作空间保存在服务端密钥代理中。
# 这些值绝不能使用 NEXT_PUBLIC_ 前缀，也不能发给浏览器。
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
